# ---------------------------------------------------------------------------
# Supabase — pegue estes valores em: Project Settings > API (no painel Supabase)
# ---------------------------------------------------------------------------

# URL do projeto. Exposta ao navegador (prefixo NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave "anon / public". Exposta ao navegador — só consegue LER,
# porque as políticas de RLS liberam apenas SELECT para o papel anon.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave "service_role". SEGREDO — só é usada no servidor (Server Actions do admin).
# Ignora RLS. Nunca use prefixo NEXT_PUBLIC_ aqui e nunca comite o valor real.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Painel de administração
# ---------------------------------------------------------------------------

# Senha única do painel /admin. Troque por algo longo e aleatório.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar (HMAC) o cookie de sessão do admin.
# Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-uma-string-aleatoria-de-64-caracteres
